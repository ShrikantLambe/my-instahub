# API (api/.env)
DATABASE_URL=postgresql://instahub:instahub@localhost:5432/instahub
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
# Like counter: "direct" (update posts.like_count per like) or "buffered" (Redis counts,
# flushed to Postgres every FLUSH_INTERVAL_SECONDS). See loadtest/RESULTS.md.
COUNTER_MODE=direct
# Home feed: "read" (query Postgres per request) or "write" (fan-out on write into
# Redis; big accounts merged at read time). See loadtest/FEED.md.
FEED_MODE=read

# Supabase Auth: Project Settings -> API. SUPABASE_JWT_SECRET is only needed for
# projects still on the legacy shared secret; new projects use JWKS from SUPABASE_URL.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=

# Object storage: moto from docker-compose locally, Cloudflare R2 in production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=instahub
S3_SECRET_ACCESS_KEY=instahub-secret
S3_BUCKET=instahub
IMAGE_BASE_URL=http://localhost:9000/instahub

# Web (web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable or anon key>
